# Server Configuration
PORT=5000
NODE_ENV=production
TRUST_PROXY=1

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=system
DB_NAME=nev_coder

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_this_in_production
REFRESH_TOKEN_EXPIRE=30d

# Email Configuration (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
# smtp | brevo_api | log | disabled
EMAIL_DELIVERY_MODE=smtp

# Brevo API mode (used when EMAIL_DELIVERY_MODE=brevo_api)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=nev-koder

# OTP Configuration
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Account Lockout Configuration
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Frontend URL
FRONTEND_URL=http://64.227.148.101

# CORS Configuration
ALLOWED_ORIGINS=http://64.227.148.101,http://localhost:5173,http://localhost:5174

# Judge0 Configuration
JUDGE0_BASE_URL=https://ce.judge0.com

# Firebase Authentication (new-users-first migration)
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json
